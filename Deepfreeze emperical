            include_projection_lines: Show projection lines
            include_metrics: Include metric annotations
            metrics_data: Dictionary of metrics to display
            
        Returns:
            TikZ code as string
        """
        print(f"Generating dynamic TikZ export with {len(fibers)} fibers...")
        
        # Sample fibers for clarity
        if len(fibers) > max_fibers:
            indices = np.linspace(0, len(fibers)-1, max_fibers, dtype=int)
            fibers = [fibers[i] for i in indices]
        
        # Sample points within fibers
        sampled_fibers = []
        for fiber in fibers:
            if len(fiber) > max_points_per_fiber:
                idx = np.linspace(0, len(fiber)-1, max_points_per_fiber, dtype=int)
                sampled_fibers.append(fiber[idx])
            else:
                sampled_fibers.append(fiber)
        
        # Scale data to fit in reasonable TikZ coordinates (-3 to 3)
        all_points = np.vstack([base_points] + [f[:, :2] for f in sampled_fibers] + [projected_points])
        scale, offset = self._compute_scaling(all_points)
        
        # Scale all data
        base_scaled = (base_points - offset) * scale
        fibers_scaled = [(f - offset) * scale for f in sampled_fibers]
        projected_scaled = (projected_points - offset) * scale
        
        # Generate TikZ code
        tikz_code = self._generate_tikz_preamble(filename)
        
        # Main TikZ picture
        tikz_code += self._generate_tikz_body(
            base_scaled, fibers_scaled, projected_scaled,
            include_projection_lines, include_metrics, metrics_data
        )
        
