    def _compute_scaling(self, points: np.ndarray, target_range=(-3, 3)) -> Tuple[float, np.ndarray]:
        """
        Compute scaling and offset to fit points in target range.
        """
        min_vals = points.min(axis=0)
        max_vals = points.max(axis=0)
        
        # Compute center
        center = (min_vals + max_vals) / 2
        
        # Compute required scaling
        ranges = max_vals - min_vals
        max_range = max(ranges)
        
        if max_range > 0:
            scale = (target_range[1] - target_range[0]) / max_range * 0.8  # 80% fill
        else:
            scale = 1.0
        
        return scale, center
    
