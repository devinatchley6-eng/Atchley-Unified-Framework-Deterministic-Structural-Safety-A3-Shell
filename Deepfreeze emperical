    def _points_to_string(self, points: np.ndarray) -> str:
        """Convert array of points to TikZ coordinate string."""
        if len(points) == 0:
            return ""
        
        # Limit to reasonable number for TikZ compilation
        max_points = 100
        if len(points) > max_points:
            indices = np.linspace(0, len(points)-1, max_points, dtype=int)
            points = points[indices]
        
        coord_strings = []
        for point in points:
            if len(point) >= 2:
                coord_strings.append(f"{point[0]:.3f}/{point[1]:.3f}")
        
        return "\n    ".join(coord_strings)
    
    def _generate_convex_hull(self, points: np.ndarray) -> str:
        """Generate convex hull of base manifold."""
        if len(points) < 3:
            return "% Not enough points for convex hull"
        
        try:
            from scipy.spatial import ConvexHull
            hull = ConvexHull(points)
            hull_points = points[hull.vertices]
            
            tikz = "% Convex hull of base manifold\n"
            tikz += "\\draw[basecolor, dashed, line width=0.4pt, fill=basecolor!10, fill opacity=0.3] "
            
            coords = " -- ".join([f"({p[0]:.3f},{p[1]:.3f})" for p in hull_points])
            tikz += coords + " -- cycle;\n"
            
            return tikz
        except:
            return "% Could not compute convex hull"
    
    def _generate_fibers_tikz(self, fibers: List[np.ndarray]) -> str:
        """Generate TikZ code for fibers."""
        tikz = "% Fibers (unsafe dimensions)\n"
        
        for i, fiber in enumerate(fibers):
            if len(fiber) < 2:
                continue
            
            # Sort by z-coordinate for proper layering
            z_order = np.argsort(fiber[:, 2])
            sorted_fiber = fiber[z_order]
            
            # Generate path
            coords = " -- ".join([f"({p[0]:.3f},{p[1]:.3f})" for p in sorted_fiber])
            
            # Vary opacity based on z-depth (simulating 3D)
            avg_z = np.mean(sorted_fiber[:, 2])
            opacity = max(0.2, min(0.7, 0.5 + avg_z * 0.1))
            
            tikz += f"\\draw[fibercolor, line width=0.8pt, opacity={opacity:.2f}] {coords};\n"
            
            # Mark start and end points
            tikz += f"\\fill[basecolor] ({sorted_fiber[0,0]:.3f},{sorted_fiber[0,1]:.3f}) circle (1.2pt);\n"
            tikz += f"\\fill[red!80] ({sorted_fiber[-1,0]:.3f},{sorted_fiber[-1,1]:.3f}) circle (1pt);\n"
        
        return tikz
    
    def _generate_projection_lines(self, fibers: List[np.ndarray]) -> str:
        """Generate projection lines from fiber points to base."""
        tikz = "% Projection lines (Deepfreeze operator)\n"
        
        # Sample every 3rd fiber and 5th point for clarity
        for i, fiber in enumerate(fibers[::3]):
            if len(fiber) == 0:
                continue
            
            # Take points at regular intervals
            indices = np.linspace(0, len(fiber)-1, min(5, len(fiber)), dtype=int)
            
            for j in indices[::2]:  # Skip some for clarity
                point = fiber[j]
                tikz += f"\\draw[projcolor, dashed, line width=0.3pt, opacity=0.4] "
                tikz += f"({point[0]:.3f},{point[1]:.3f}) -- ({point[0]:.3f},{point[1]:.3f - 0.5});\n"
        
        return tikz
    
    def _generate_metrics_annotation(self, metrics_data: Dict) -> str:
        """Generate metric annotations."""
        if not metrics_data:
            return ""
        
        tikz = "\n% Empirical Metrics Annotation\n"
        tikz += "\\begin{scope}[shift={(3.5, 2.5)}]\n"
        tikz += "\\draw[fill=white, fill opacity=0.9, draw=black!30, rounded corners=3pt] "
        tikz += "(-1.2, -1.8) rectangle (1.2, 1.2);\n"
        tikz += "\\node[anchor=north west, text width=2.2cm] at (-1.0, 1.0) {\n"
        tikz += "  \\footnotesize\\bfseries Empirical Metrics\\\\\n"
        tikz += "  \\scriptsize\\mdseries\n"
        
        # Add key metrics
        key_metrics = {
            'manifold_coverage': 'Coverage',
            'novelty_mean': 'Novelty',
            'diversity_mean': 'Diversity',
            'qd_score': 'QD Score'
        }
        
        for key, label in key_metrics.items():
            if key in metrics_data:
                value = metrics_data[key]
                color = 'green!70!black' if value > 0.7 else 'orange!70!black' if value > 0.4 else 'red!70!black'
                tikz += f"  \\textcolor{{{color}}}{{{label}: {value:.3f}}}\\\\\n"
        
        tikz += "};\n"
        tikz += "\\end{scope}\n"
        
        return tikz

